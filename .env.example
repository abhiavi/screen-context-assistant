# Copy to .env and fill in. Never commit the real .env.

# LiteLLM gateway (adraca-azure-01). Fallback: http://100.70.197.5:4000/v1 (oracle-01)
LITELLM_BASE_URL=http://100.125.158.117:4000/v1
LITELLM_API_KEY=

# Model aliases (confirmed live against the gateway during Phase-0 gate check)
EMBEDDING_MODEL=text-embedding-004
VISION_MODEL=qwen-vl-ocr
SYNTHESIS_MODEL=glm-4.7

# Local storage (aws-01 only, do not point at azure-01's shared Qdrant)
QDRANT_HOST=100.96.7.56
QDRANT_PORT=6333
QDRANT_COLLECTION=screen-context

POSTGRES_HOST=100.96.7.56
POSTGRES_PORT=5432
POSTGRES_DB=screen_context
POSTGRES_USER=screen_context
POSTGRES_PASSWORD=change-me

# Bind address for the ingest/RAG API - Tailscale IP only, never 0.0.0.0
BIND_HOST=100.96.7.56
INGEST_PORT=8088
RAG_PORT=8089

# Transmission boundary (see plan §5). Default: never upload raw frames off-fleet.
UPLOAD_RAW_FRAMES=false
RETAIN_RAW_FRAMES=false
RAW_FRAME_RETENTION_SECONDS=300
FRAME_VECTOR_RETENTION_DAYS=30
